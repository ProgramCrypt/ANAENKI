{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "Build ANÆNKI",
            "command": "g++",
            "args": [
                "-fdiagnostics-color=always",
                "main.cpp",
                "renderSystem.cpp",
                "testScene.cpp",
                "logSystem.cpp",
                "${workspaceFolder}/geometry/matrix.cpp",
                "-o",
                "${workspaceFolder}/main.exe",
                "-I${env:SDL_INCLUDE_PATH}",
                "-L${env:SDL_LIB_PATH}",
                "-lSDL3",
                "-lSDL3_ttf"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build",
            "detail": "Task generated by Debugger."
        }
    ],
    "version": "2.0.0"
}